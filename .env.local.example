# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
# Modern publishable key (sb_publishable_…). The legacy anon JWT also works if
# you set NEXT_PUBLIC_SUPABASE_ANON_KEY instead.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional, server-only (sb_secret_… or legacy service_role JWT). Unused in v1.
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare Realtime — TURN relay (preferred; 1,000 GB/month free tier).
# Create a TURN key at dash.cloudflare.com → Realtime → TURN Server; both
# values are server-only. Calls fall back to STUN-only without them.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=

# Metered.ca — legacy TURN fallback, used only when Cloudflare isn't
# configured. Safe to remove after the Cloudflare migration is verified.
# May be either a bare API key (with METERED_APP_DOMAIN) OR the full
# credentials URL pasted directly, e.g.
#   https://<domain>.metered.live/api/v1/turn/credentials?apiKey=<key>
METERED_API_KEY=
METERED_APP_DOMAIN=pact

# Public base URL of this deployment
NEXT_PUBLIC_APP_URL=http://localhost:3000
